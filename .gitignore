# proxy runtime data (generated by the app / container, may contain secrets)
/proxy-manager/data/
/proxy-manager/letsencrypt/
/proxy-manager/backup/
/proxy-manager/certs/*
!/proxy-manager/certs/.gitkeep
/proxy-manager/logs/*
!/proxy-manager/logs/.gitkeep
/proxy-manager/conf.d/host-*.conf
/proxy-manager/state.json
*.pem